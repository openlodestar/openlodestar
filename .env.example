# OpenLodestar 在线链路配置模板（项目级，不是每个 demo 各一份）
#
# 用法：
#   cp .env.example .env
#   # 填入真实钥匙；.env 已被 .gitignore 忽略，不会入库
#
# 运行在线命令时用 Node 的 --env-file=.env 读取；具体命令见 README。
# demo / verify-quotes / audit 三个离线命令不需要这里的任何变量。
# 在线实验的底稿目录、报告路径请用命令行参数（--data / --report）指定，
# 不要把某次实验的路径写死在这里。

# ---- 模型（在线链路必填）----
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_TEXT_MODEL=gpt-4o-mini
LLM_VISION_MODEL=gpt-4o
LLM_WEB_MODEL=gpt-4o-mini
# LLM_SEND_THINKING=1

# 使用 OpenAI 原生搜索模型时，取消下面两行的注释，并改掉上面的 LLM_WEB_MODEL：
# LLM_WEB_MODEL=gpt-4o-search-preview
# OPENLODESTAR_LLM_SEARCH_BODY='{"web_search_options":{}}'

# ---- 搜索 ----
# llm-web：默认值，用模型自带的联网搜索；有 LLM_API_KEY 即可，但不支持 site: 定向查询
# serper：独立搜索 API，支持 site:，需要 SERPER_API_KEY
SEARCH_PROVIDER=llm-web
# SERPER_API_KEY=
# SERPER_BASE_URL=
SEARCH_RESULT_COUNT=10

# DashScope 兼容模式的联网开关（默认值；不是该服务可留空）
# OPENLODESTAR_LLM_SEARCH_BODY='{"enable_search":true}'

# ---- 浏览器 ----
# 瓷器包声明浏览器必备；先跑 pnpm run browser:install
BROWSER_PLUGIN=playwright

# ---- 底稿与 trace ----
# 建议用命令行 --data 指定本次实验的独立目录，而不是写在这里
# OPENLODESTAR_DATA_DIR=
# OPENLODESTAR_ANCHORS_FILE=
# OPENLODESTAR_TRACE_DIR=
# OPENLODESTAR_WHITELIST_FILE=
# OPENLODESTAR_BLACKLIST_FILE=

# ---- 预算与日志（默认值，按需打开）----
# LODESTAR_MAX_SEARCH_CALLS=4
# LODESTAR_MAX_PAGES=6
# LODESTAR_PAGE_TEXT_BUDGET=16000
# LODESTAR_MAX_QUOTE_CHARS=1000
# OPENLODESTAR_PAGE_TIMEOUT_MS=25000
# OPENLODESTAR_LOG=warn
